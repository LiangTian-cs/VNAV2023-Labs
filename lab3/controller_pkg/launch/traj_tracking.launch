
<launch>
  <!-- Launch desired trajectory -->
  <node name="traj_publisher" pkg="controller_pkg" type="traj_publisher"/>

  <!-- Launch our controller -->
  <node name="controller_node" pkg="controller_pkg" type="controller_node"/>

  <!-- Controller gains -->
  <param name="kx" type="double" value="1.0" />
  <param name="kv" type="double" value="2.5" />
  <param name="kr" type="double" value="0.08" />
  <param name="komega" type="double" value="0.10" />
  <param name="kr_xy" type="double" value="0.80" />
  <param name="komega_xy" type="double" value="1.60" />

</launch>
